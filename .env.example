# Copy this file to .env and fill it in. .env is git-ignored: never commit it.
# From developer.paypal.com > Apps & Credentials, with the toggle on SANDBOX.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: the local port (default 4242).
PORT=4242
# Optional: an email when a purchase waits for your approval, so your phone buzzes. Use a Gmail App Password
# (myaccount.google.com/apppasswords, needs 2-Step Verification), not your Google password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where the alert goes; empty means GMAIL_USER.
ALERT_EMAIL=
